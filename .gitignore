# Monorepo — applies to all packages under apps/ and servers/

# Dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Env & secrets
.env
.env.*.local
!.env.example

# Tooling / OS
.DS_Store
.idea/
.vscode/
*.pem
*.tsbuildinfo

# Next.js (culin-backend)
**/.next/
**/out/
**/build/

# Expo (culin-ai-app)
**/.expo/
**/web-build/
**/dist/
apps/culin-ai-app/expo-env.d.ts

# Metro
**/.metro-health-check*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# Vercel
**/.vercel

# Android / iOS native (Expo)
apps/culin-ai-app/android/
apps/culin-ai-app/ios/
**/*.jks
**/*.p8
**/*.p12
**/*.mobileprovision

# Firebase (if added under app)
**/google-services.json
**/GoogleService-Info.plist
