# Nutrition Estimation Engine (FastAPI) — copy to `.env` in this directory.
# For local: run from `servers/nutrition-estimation/nutrition_engine` (see root package.json `dev:nutrition`).
# Never commit `.env`.

# Align JWT verification with the mobile app Cognito user pool.
COGNITO_USER_POOL_ID=us-east-1_a8FLRTD6D
COGNITO_REGION=us-east-1

# Layer 1 (DB) — without DATABASE_URL + SECRET_KEY, Layer 1 may return stub data.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SECRET_KEY=your-secret-key

# Layer 0 — /estimate-from-text (returns 503 if LLM_API_KEY is unset in production)
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
#
# Gemini is often slow during demand spikes — avoid false timeouts / pointless 500s:
# GEMINI_TIMEOUT_S=45
# GEMINI_MAX_RETRIES=3
#
# v1 UX: ONE Gemini macro call for POST /estimate-from-text (default ON). Disable for full layered pipeline only.
# ESTIMATE_SIMPLE_LLM=1

# CORS — comma-separated origins, or * for local dev only
CORS_ORIGINS=*

# Optional — FatSecret proxy (/food/…); 503 if unset
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
# FATSECRET_API_BASE=https://platform.fatsecret.com/rest/server.api
# FATSECRET_TOKEN_URL=https://oauth.fatsecret.com/connect/token

# Optional — API key auth (comma-separated). Empty = disabled (dev only).
# API_KEYS=

# Optional — tuning
# NUTRITION_ARTIFACTS=artifacts
# NUTRITION_CACHE_MAXSIZE=10000
# NUTRITION_WORKERS=2
# RATE_LIMIT_RPM=30
# PORT=8000
