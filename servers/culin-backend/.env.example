# CulinAI Next.js backend — copy to `.env.local` in this directory (Next loads it automatically).
# Never commit `.env` or `.env.local`.
#
# See also: `apps/culin-ai-app/.env.example` (Expo) — Cognito and API URLs should stay aligned.

# -----------------------------------------------------------------------------
# Cognito (browser / OIDC; used by web UI and public client config)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_a8FLRTD6D
NEXT_PUBLIC_COGNITO_CLIENT_ID=36623hj9j2uq5st5ki9esi51eu
# Optional: full issuer URL; default is built from region + user pool id
# NEXT_PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_a8FLRTD6D
# Hosted UI domain, e.g. your-domain.auth.us-east-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_DOMAIN=
# Optional identity pool
# NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_LOGOUT_URI=http://localhost:3000
NEXT_PUBLIC_COGNITO_SCOPES=phone openid email

# -----------------------------------------------------------------------------
# PostgreSQL (src/lib/db.ts) — set RDS_PASSWORD for any environment using the DB
# -----------------------------------------------------------------------------
# RDS_HOST=culinai-db.csn2c4yowuvc.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DATABASE=culinAI_DB
# RDS_USER=culinAI_DB
RDS_PASSWORD=

# -----------------------------------------------------------------------------
# App & integrations
# -----------------------------------------------------------------------------
# OpenAI (src/app/api/gptService.ts)
# OPENAI_API_KEY=
# USDA FDC + Spoonacular (src/app/api/nutritionService.ts)
# USDA_FDC_API_KEY=
# SPOONACULAR_API_KEY=
# Instacart (src/app/api/instacartService.ts)
# INSTACART_API_KEY=
# FooDB (src/app/api/fetchComp.ts)
# FOODB_API_KEY=
# FOODB_BASE_URL=http://35.184.189.38/api/foodb
# Public URL of this app (e.g. for chat linkbacks)
# APP_BASE_URL=http://localhost:3000
# AWS region for Bedrock (src/app/api/bedrockClient.ts)
# AWS_REGION=us-east-1
# External flavor service
# FLAVOR_RECOMMENDER_BASE_URL=http://localhost:8000
