# CulinAI mobile app (Expo) — copy to `.env` in this directory.
# Never commit a filled `.env`.

# -----------------------------------------------------------------------------
# AWS Cognito (required for sign-in; must match the backend / nutrition pool)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_a8FLRTD6D
EXPO_PUBLIC_COGNITO_CLIENT_ID=36623hj9j2uq5st5ki9esi51eu

# -----------------------------------------------------------------------------
# Firebase (optional; app has fallbacks in src/config/firebase.ts if unset)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=culinai-app.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=culinai-app
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=culinai-app.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# CulinAI Next.js API (src/services/culinaiApi.ts) — /api/chat, /api/user/profile, …
# Default below matches production (DigitalOcean); override for local monorepo dev.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_CULINAI_API_URL=https://api.recipe-gen.culin.ai
# Monorepo local (Next on port 3000; use your LAN IP for a physical device):
# EXPO_PUBLIC_CULINAI_API_URL=http://192.168.1.10:3000

# -----------------------------------------------------------------------------
# Nutrition engine + FatSecret proxy (src/config/api.ts, src/services/nutritionApi.ts)
# POST /estimate, POST /estimate-from-text, /food/* — same base URL as FatSecret by default
# Default below matches production (DigitalOcean); override for local.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_NUTRITION_API_URL=https://api.nutrition-engine.culin.ai
# EXPO_PUBLIC_NUTRITION_API_URL=http://192.168.1.10:8000
# If FatSecret is hosted separately, set; otherwise it defaults to the nutrition base URL
# EXPO_PUBLIC_FATSECRET_API_URL=
